# SPDX-License-Identifier: AGPL-3.0-only

[Unit]
Description=Tihulu Minimized Windows Preview Daemon
Documentation=https://github.com/Tihulu/tihulu-cosmic-minimized-windows
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=tihulu-previewd
Restart=on-failure
RestartSec=2s
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=graphical-session.target
