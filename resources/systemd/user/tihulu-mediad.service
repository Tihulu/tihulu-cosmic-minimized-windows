[Unit]
Description=Tihulu Minimized Windows media helper
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tihulu-mediad
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
MemoryMax=192M
TasksMax=32
LimitNOFILE=128

[Install]
WantedBy=default.target
